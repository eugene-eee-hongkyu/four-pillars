{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:web",
  "installCommand": "pnpm install",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!_expo|assets|favicon|api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/interpret-premium.js": { "maxDuration": 300 },
    "api/interpret-free.js": { "maxDuration": 120 },
    "api/relation-mini.js": { "maxDuration": 60 }
  }
}
